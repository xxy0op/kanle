# Docker Compose 配置
# 服务器部署时只需下载 docker-compose.yml、.env.example 和 deploy/nginx.compose.conf
# 使用前复制为 .env：cp .env.example .env

# ===== 应用镜像版本 =====
# latest 跟随 main 分支；Release 部署可改为具体版本，例如 1.0.0。
IMAGE_TAG=latest

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=change-this-root-password
DB_NAME=moment_blog
DB_USER=kanle
DB_PASSWORD=change-this-db-password

# ===== JWT 认证 =====
JWT_SECRET=please-generate-a-long-random-string
JWT_EXPIRES_IN=7d

# ===== 初始管理员（仅首次初始化数据库时生效） =====
ADMIN_EMAIL=admin@kanle.net
ADMIN_PASSWORD=change-this-admin-password
ADMIN_USERNAME=admin

# ===== 公网访问地址 =====
# 如果使用域名，请改为 https://yourdomain.com；使用非 80 端口时带上端口号。
CLIENT_URL=http://localhost

# ===== 按需重验证密钥 =====
# 生产环境请改为随机长字符串；此变量只注入服务端。
REVALIDATE_SECRET=please-generate-another-long-random-string

# ===== Compose 入口端口 =====
# 80 端口被占用时可改为 8080 等未占用端口。
HTTP_PORT=80
