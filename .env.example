# Docker Compose 配置
# 服务器部署时只需下载 docker-compose.yml 和 .env.example
# 使用前复制为 .env：cp .env.example .env

# ===== 应用镜像版本 =====
# latest 跟随 main 分支；Release 部署可改为具体版本，例如 1.0.0。
IMAGE_TAG=latest

# ===== 外部 MySQL =====
# kanle 使用 MySQL，不在应用容器内运行数据库。
# MySQL 在当前宿主机时使用 host.docker.internal；远程数据库请填写实际地址。
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=moment_blog
DB_USER=kanle
DB_PASSWORD=change-this-db-password

# ===== JWT 认证 =====
JWT_SECRET=please-generate-a-long-random-string
JWT_EXPIRES_IN=7d

# ===== 初始管理员（仅首次初始化数据库时生效） =====
ADMIN_EMAIL=admin@kanle.net
ADMIN_PASSWORD=change-this-admin-password
ADMIN_USERNAME=admin

# ===== 公网访问地址 =====
# 如果使用域名，请改为 https://yourdomain.com；使用非 80 端口时带上端口号。
CLIENT_URL=http://localhost:3000

# ===== 按需重验证密钥 =====
# 生产环境请改为随机长字符串；此变量只注入服务端。
REVALIDATE_SECRET=please-generate-another-long-random-string

# ===== Compose 入口端口 =====
# 3000 端口被占用时可改为 8080 等未占用端口。
HTTP_PORT=3000
